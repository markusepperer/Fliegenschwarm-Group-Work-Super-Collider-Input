autowatch=1; inlets=37; outlets=3;
var namespace=(jsarguments.length>1)?String(jsarguments[1]):"default";
var leaders=new Global("MS_SwarmLeaders_"+namespace);
var voiceId=0, voiceCount=1, swarmCount=1, oldSwarmCount=1;
